FROM golang:1.25.10-alpine AS builder
WORKDIR /workspace
COPY adapters/go.mod adapters/go.sum ./
RUN go mod download
COPY adapters/ .
RUN go build -o /out/kape-adapter-audit ./cmd/audit/...

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /out/kape-adapter-audit /kape-adapter-audit
ENTRYPOINT ["/kape-adapter-audit"]
