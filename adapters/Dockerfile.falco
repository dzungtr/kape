FROM golang:1.25-alpine AS builder
WORKDIR /workspace
COPY adapters/go.mod adapters/go.sum ./
RUN go mod download
COPY adapters/ .
RUN go build -o /out/kape-adapter-falco ./cmd/falco/...

FROM gcr.io/distroless/static:nonroot
COPY --from=builder /out/kape-adapter-falco /kape-adapter-falco
ENTRYPOINT ["/kape-adapter-falco"]
