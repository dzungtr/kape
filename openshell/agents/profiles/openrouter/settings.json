{
  "lastChangelogVersion": "0.84.4",
  "theme": "dark",
  "tuiMode": "fullscreen",
  "thinkingBudgets": {
    "minimal": 1024,
    "low": 4096,
    "medium": 10240,
    "high": 32768,
    "xhigh": 65536,
    "max": 128000
  },
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "defaultProvider": "openrouter",
  "defaultModel": "z-ai/glm-5.3-flash",
  "subagents": {
    "defaultModel": "openrouter/z-ai/glm-5.3-flash",
    "agentOverrides": {
      "scount": {
        "thinking": "medium",
        "model": "openrouter/z-ai/glm-5.3-flash"
      },
      "researcher": {
        "model": "openrouter/z-ai/glm-5.3-flash",
        "thinking": "high"
      },
      "delegate": {
        "model": "openrouter/z-ai/glm-5.3-flash",
        "thinking": "high"
      },
      "worker": {
        "model": "openrouter/z-ai/glm-5.3-flash",
        "thinking": "high"
      },
      "reviewer": {
        "model": "openrouter/z-ai/glm-5.3",
        "thinking": "medium"
      },
      "pr-reviewer": {
        "model": "openrouter/z-ai/glm-5.3",
        "thinking": "medium"
      },
      "design-arch": {
        "model": "openrouter/z-ai/glm-5.3",
        "thinking": "max"
      },
      "oracle": {
        "model": "openrouter/z-ai/glm-5.3",
        "thinking": "max"
      }
    },
    "modelScope": {
      "enforce": false
    }
  },
  "packages": [
    "npm:pi-mcp-adapter",
    "npm:pi-claude-marketplace",
    "npm:@desek/pi-opentelemetry",
    "npm:@tigorhutasuhut/pi-rules"
  ],
  "quietStartup": true
}
